+"""Tests for vesuvius.tifxyz audit CLI helpers (light imports)."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+import tifffile
+
+
+def _load(name: str, path: Path, package: str = "vesuvius.tifxyz"):
+    spec = importlib.util.spec_from_file_location(
+        f"{package}.{name}", path, submodule_search_locations=[str(path.parent)]
+    )
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    assert spec.loader is not None
+    spec.loader.exec_module(mod)
+    return mod
+
+
+_TIFXYZ = Path(__file__).resolve().parents[2] / "src" / "vesuvius" / "tifxyz"
+# Prefer source-tree modules under test; fall back to installed package path.
+if not (_TIFXYZ / "meta_frames.py").is_file():
+    import vesuvius
+
+    _TIFXYZ = Path(vesuvius.__file__).resolve().parent / "tifxyz"
+
+meta_frames = _load("meta_frames", _TIFXYZ / "meta_frames.py")
+sys.modules["vesuvius.tifxyz.meta_frames"] = meta_frames
+tiff_util = _load("audit_tiff_util", _TIFXYZ / "audit_tiff_util.py")
+sys.modules["vesuvius.tifxyz.audit_tiff_util"] = tiff_util
+
+# audit_checks imports vesuvius.tifxyz.meta_frames / audit_tiff_util
+checks = _load("audit_checks", _TIFXYZ / "audit_checks.py")
+report = _load("audit_report", _TIFXYZ / "audit_report.py")
+# Patch report's Finding import already bound
+
+audit_paths = checks.audit_paths
+discover_tifxyz_dirs = checks.discover_tifxyz_dirs
+exit_code = report.exit_code
+
+
+def _write_tifxyz(path: Path, *, scale=(0.05, 0.05), voxel_size_um=None, shape=(8, 10)):
+    path.mkdir(parents=True, exist_ok=True)
+    meta = {"uuid": path.name, "scale": list(scale), "type": "seg", "format": "tifxyz"}
+    if voxel_size_um is not None:
+        meta["voxel_size_um"] = voxel_size_um
+    (path / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
+    h, w = shape
+    z = np.zeros((h, w), dtype=np.float32)
+    for name in ("x.tif", "y.tif", "z.tif"):
+        tifffile.imwrite(path / name, z)
+    return path
+
+
+def test_float_tolerant_ambiguity(tmp_path: Path):
+    mesh = tmp_path / "mesh"
+    _write_tifxyz(mesh / "a-1.129um.tifxyz", scale=(0.05, 0.05))
+    _write_tifxyz(
+        mesh / "b-45.532um.tifxyz",
+        scale=(0.05000000074505806, 0.05000000074505806),
+    )
+    assert len(discover_tifxyz_dirs([tmp_path])) == 2
+    _, findings = audit_paths([mesh], skip_tiff=True)
+    amb = [f for f in findings if f.code == "scale_frame_ambiguity"]
+    assert len(amb) == 1
+    assert exit_code(findings) == 0
+    assert exit_code(findings, strict=True) == 1
+
+
+def test_meta_error_exit(tmp_path: Path):
+    d = tmp_path / "bad.tifxyz"
+    d.mkdir()
+    (d / "meta.json").write_text("{")
+    _, findings = audit_paths([d], skip_tiff=True)
+    assert exit_code(findings) == 2
