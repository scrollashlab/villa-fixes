+"""README entrypoint table must match [project.scripts] (villa #1520)."""
+
+from __future__ import annotations
+
+import re
+import tomllib
+from pathlib import Path
+
+import pytest
+
+VESUVIUS_ROOT = Path(__file__).resolve().parents[1]
+README = VESUVIUS_ROOT / "README.md"
+PYPROJECT = VESUVIUS_ROOT / "pyproject.toml"
+
+# Ghosts called out in https://github.com/ScrollPrize/villa/issues/1520
+REMOVED_ENTRYPOINTS = (
+    "vesuvius.render_obj",
+    "vesuvius.flatten_obj",
+    "vesuvius.proofreader",
+)
+
+
+def _readme_entrypoint_names() -> list[str]:
+    text = README.read_text(encoding="utf-8")
+    # Only the Entrypoints table: from the heading until the next ## heading.
+    match = re.search(
+        r"### Entrypoints:\s*\n+(.*?)\n##\s",
+        text,
+        flags=re.DOTALL,
+    )
+    assert match, "could not find '### Entrypoints:' table in vesuvius/README.md"
+    table = match.group(1)
+    names = re.findall(r"\|\s*`((?:vesuvius\.)[^`]+)`\s*\|", table)
+    assert names, "Entrypoints table listed no `vesuvius.*` names"
+    return names
+
+
+def _project_script_names() -> set[str]:
+    data = tomllib.loads(PYPROJECT.read_text(encoding="utf-8"))
+    scripts = data.get("project", {}).get("scripts", {})
+    assert scripts, "[project.scripts] is empty"
+    return set(scripts)
+
+
+def test_readme_entrypoint_names_are_declared_scripts():
+    scripts = _project_script_names()
+    readme_names = _readme_entrypoint_names()
+    missing = [name for name in readme_names if name not in scripts]
+    assert not missing, (
+        "README Entrypoints table lists names absent from [project.scripts]: "
+        + ", ".join(missing)
+    )
+
+
+def test_removed_entrypoints_are_not_listed_as_scripts():
+    readme_names = set(_readme_entrypoint_names())
+    still_listed = [name for name in REMOVED_ENTRYPOINTS if name in readme_names]
+    assert not still_listed, (
+        "README still documents retired entrypoints from #1520: "
+        + ", ".join(still_listed)
+    )
+
+
+def test_readme_does_not_instruct_running_proofreader_console_script():
+    text = README.read_text(encoding="utf-8")
+    assert "Run `vesuvius.proofreader`" not in text
+    assert "/utils/vc_proofreader/config.py" not in text
